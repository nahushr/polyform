{
  "name": "@simplishelf/polyform",
  "version": "0.1.2",
  "description": "Config driven React forms built from reusable field components.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nahushr/polyform.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "assets/polyform-logo.png"
  ],
  "main": "./dist/polyform.js",
  "module": "./dist/polyform.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/polyform.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.scss",
    "./dist/style.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev:example": "npm run dev --workspace polyform-vite-demo",
    "preview:example": "npm run preview --workspace polyform-vite-demo"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
