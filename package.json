    "country-state-city": "^3.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.0"
  },
  "peerDependenciesMeta": {
    "country-state-city": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
