    "mui-tiptap": "^1.28.1",
    "react-imask": "^7.6.1",
    "react-toastify": "^10.0.4"
  },
  "devDependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^7.0.0",
    "@types/node": "^20.14.12",
